{
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".worktrees",
    "backups",
    ".codex-backups",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "compilerOptions": {
    "incremental": false
  }
}
