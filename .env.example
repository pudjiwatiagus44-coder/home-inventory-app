NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Android internal-test APK download address shown on the invitation landing page.
# Host the latest APK on the server (e.g. https://homestorag.xyz/apk/home-inventory-internal-latest.apk).
NEXT_PUBLIC_APK_DOWNLOAD_URL=

# Mainland production draft. Server-side only; never prefix with NEXT_PUBLIC_.
DATABASE_URL=
SESSION_SECRET=
# Test HTTP deployments only. Leave empty or set true when HTTPS is enabled.
AUTH_COOKIE_SECURE=

# Optional local/test PostgreSQL integration verification.
# Must point to a disposable database whose name includes "test".
TEST_DATABASE_URL=

# Password reset email (SMTP, e.g. QQ Mail smtp.qq.com:465 + authorization code).
# Server-side only; never prefix with NEXT_PUBLIC_. Real values live in server app.env only.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
RESET_BASE_URL=https://homestorag.xyz

# Photo recognition (Volcengine Doubao Vision). Server-side only; never prefix with NEXT_PUBLIC_.
DOUBAO_API_KEY=
DOUBAO_VISION_MODEL=doubao-1.5-vision-lite-250315
DOUBAO_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
PHOTO_STORAGE_DIR=./data/photos

# Bookkeeping text fallback (Alibaba Cloud Model Studio, Beijing workspace). Server-side only.
# QWEN_TEXT_BASE_URL must be this workspace's OpenAI-compatible chat completions URL, for example:
# https://ws-<workspace-domain>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
# qwen3.7-flash is used when QWEN_TEXT_MODEL is empty. Allowed override: qwen3.7-flash-2026-07-15.
QWEN_API_KEY=
QWEN_TEXT_BASE_URL=
QWEN_TEXT_MODEL=
# User-triggered rerecognition reuses the configured text model; only the visual fallback changes model.
DOUBAO_RERECOGNITION_TEXT_MODEL=
# User-authorized order screenshot rerecognition; use the same Beijing workspace compatible endpoint.
QWEN_VISION_BASE_URL=
QWEN_VISION_MODEL=qwen3.5-ocr
DOUBAO_RERECOGNITION_VISION_MODEL=doubao-1.5-vision-lite-250315
BOOKKEEPING_CREDENTIAL_ACTIVE_KEY_VERSION=1
BOOKKEEPING_CREDENTIAL_MASTER_KEYS={"1":"BASE64_ENCODED_32_BYTE_KEY"}
